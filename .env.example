# Copy to .env and fill in real values before `docker compose up`.
# Requires a static ngrok domain (passkeys, Google redirect URI, BotFather domain).

PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
PUBLIC_HOST=your-subdomain.ngrok-free.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram upstream credentials from BotFather Web Login (not the bot token).
# Register the broker's public callback URL in BotFather:
#   ${PUBLIC_BASE_URL}/oidc/telegram/callback
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=

# Credentials Kratos uses only with the internal auth-service OIDC broker.
# Generate a high-entropy value (for example: openssl rand -base64 32).
TELEGRAM_BROKER_CLIENT_ID=kratos
TELEGRAM_BROKER_CLIENT_SECRET=

COURIER_WEBHOOK_SECRET=dev-courier-secret
JWT_ISSUER=
JWT_AUDIENCE=kratos-poc-web
JWT_TTL=1h
PROFILE_IDENTIFIER_SALT=dev-salt-change-me
DYNAMODB_REGION=us-east-1
LOG_LEVEL=info
